platform :ios, '13.0'
use_frameworks!

target 'CT-PL-Pn-Integration' do
  pod 'CleverTap-iOS-SDK'
  pod 'Plotline'
end

target 'NotificationServiceExtension' do
  pod 'CTNotificationService'
  pod 'Plotline'
end

# Plotline Notification Content Extension - renders Plotline rich push templates
# (PLOTLINE_RICH category). iOS routes content extensions by the payload category,
# so this must stay separate from the CleverTap content extension.
target 'PlContent' do
  pod 'Plotline'
end

# CleverTap Notification Content Extension - renders CleverTap rich push templates
# (carousel, timer, advanced) inside the notification.
target 'CTContent' do
  pod 'CTNotificationContent'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
