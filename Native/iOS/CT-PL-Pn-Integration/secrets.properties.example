# Template for secrets.properties.
# Copy this file to secrets.properties (same folder) and fill in real values.
# secrets.properties is gitignored and must never be committed.
#
# The app loads this file from its bundle at runtime via AppConfig.swift.

# CleverTap credentials (CleverTap Dashboard > Settings > Projects).
CLEVERTAP_ACCOUNT_ID=YOUR_CLEVERTAP_ACCOUNT_ID
CLEVERTAP_TOKEN=YOUR_CLEVERTAP_ACCOUNT_TOKEN
CLEVERTAP_REGION=YOUR_CLEVERTAP_REGION

# Plotline credentials (Plotline dashboard).
PLOTLINE_API_KEY=YOUR_PLOTLINE_API_KEY
PLOTLINE_USER_ID=YOUR_PLOTLINE_USER_ID

# Test user identity used by identifyCleverTapUser().
CLEVERTAP_USER_NAME=YOUR_USER_NAME
CLEVERTAP_USER_IDENTITY=YOUR_USER_IDENTITY
CLEVERTAP_USER_EMAIL=YOUR_USER_EMAIL

# App Group shared between the app and the NotificationServiceExtension
# (required for Plotline rich push + CleverTap rich media in the extension).
# Must match the value configured in BOTH .entitlements files.
APP_GROUP_ID=group.com.yourcompany.yourapp