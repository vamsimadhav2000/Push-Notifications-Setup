<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to allow the app to send events and user profile information -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Recommended so that MoEngage knows when to attempt a network call -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required to show push notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- MoEngage push notifications can vibrate -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- MoEngage syncs and displays push notifications after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required for the Plotline "Timer with Progress Bar" push template on Android 12+ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".MoEApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoEPLPnIntegration">

        <!--
            MoEngage's auto-integration service. It receives every FCM message,
            renders MoEngage pushes itself (rich media, push templates, in-app,
            click tracking) and forwards any non-MoEngage payload to the
            NonMoEngagePushListener registered in MoEApplication, which routes
            Plotline pushes to the Plotline SDK.
            Note: MoEngage 14.x does not auto-merge this service, so it is
            declared here. Default priority beats firebase-messaging's base
            service (priority -500), keeping this the single MESSAGING_EVENT
            receiver.
        -->
        <service
            android:name="com.moengage.firebase.MoEFireBaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- MoEngage receivers/activities for push rendering, in-app, and rich
             landing (MoEActivity) are auto-merged from the MoEngage modules. -->

        <!-- Handles Plotline push notification clicks -->
        <activity
            android:name="so.plotline.insights.Activities.PlotlinePushActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.MoEPLPnIntegration">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom scheme deep link: moeplpn://deeplink/... (e.g. moeplpn://deeplink/home) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="moeplpn"
                    android:host="deeplink" />
            </intent-filter>

            <!-- Verified App Link: https://yourdomain.com/moeplpn/...
                 Requires hosting assetlinks.json on the domain for auto-open on Android 12+.
                 Replace yourdomain.com with a domain you own. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="yourdomain.com"
                    android:pathPrefix="/moeplpn" />
            </intent-filter>
        </activity>
    </application>

</manifest>