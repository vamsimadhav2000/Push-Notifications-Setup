# Template for secrets.properties.
# Copy this file to secrets.properties (same folder) and fill in real values.
# secrets.properties is gitignored and must never be committed.

# MoEngage credentials (MoEngage Dashboard > Settings > Account > General > Workspace ID).
# Data center code: 1..6 (DATA_CENTER_1 .. DATA_CENTER_6) depending on your region.
MOENGAGE_APP_ID=YOUR_MOENGAGE_WORKSPACE_ID
MOENGAGE_DATA_CENTER=1

# Plotline credentials (Plotline dashboard).
PLOTLINE_API_KEY=YOUR_PLOTLINE_API_KEY
PLOTLINE_USER_ID=YOUR_PLOTLINE_USER_ID

# Test user identity used by MainActivity (MoEngage + Plotline share this user).
MOE_USER_NAME=YOUR_USER_NAME
MOE_USER_ID=YOUR_USER_IDENTITY
MOE_USER_EMAIL=YOUR_USER_EMAIL