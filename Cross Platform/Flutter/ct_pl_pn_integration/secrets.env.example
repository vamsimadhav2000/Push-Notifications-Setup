# Copy this file to secrets.env and fill in your real values.
# secrets.env is gitignored and stays local.
#
# Usage:
#   flutter run --dart-define-from-file=secrets.env
#
# Android reads these for the manifest (android/app/build.gradle.kts).
# iOS reads them from ios/Flutter/Secrets.xcconfig (keep the two in sync).

# CleverTap dashboard -> Settings -> Integration -> Account ID / Token (Project ID / Project Token)
CLEVERTAP_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
CLEVERTAP_ACCOUNT_TOKEN=REPLACE_WITH_ACCOUNT_TOKEN

# Demo user profile used by CleverTapPlugin.onUserLogin()
CT_DEMO_USER_ID=REPLACE_WITH_USER_ID
CT_DEMO_USER_NAME=REPLACE_WITH_USER_NAME
CT_DEMO_USER_EMAIL=REPLACE_WITH_USER_EMAIL

# Plotline dashboard -> Credentials tab (https://insights.plotline.so/)
PLOTLINE_API_KEY=REPLACE_WITH_PLOTLINE_API_KEY
PLOTLINE_USER_ID=REPLACE_WITH_PLOTLINE_USER_ID